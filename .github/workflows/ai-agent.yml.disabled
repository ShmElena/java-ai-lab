name: AI Agent

on:
  issues:
    types: [opened]
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]

jobs:
  run-agent:
    runs-on: ubuntu-latest
    if: "!contains(github.event.issue.labels.*.name, 'aider')"
    permissions:
      issues: write
      contents: write
      pull-requests: write
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - run: pip install google-genai PyGithub

      - name: Run agent
        run: python .github/scripts/agent.py
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          ISSUE_NUMBER: ${{ github.event.issue.number || github.event.pull_request.number }}
          EVENT_NAME: ${{ github.event_name }}
          REVIEW_FILE: ${{ github.event.comment.path }}
          REVIEW_LINE: ${{ github.event.comment.line }}
          REVIEW_BODY: ${{ github.event.comment.body }}
          PR_BRANCH: ${{ github.event.pull_request.head.ref }}
          SENDER_LOGIN: ${{ github.event.sender.login }}
